{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && NPM_CONFIG_LEGACY_PEER_DEPS=true vinext build",
    "dev": "vinext dev --hostname 0.0.0.0",
    "start": "vinext start --hostname 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test backend/domain/home-alert-rules.test.ts backend/domain/budget-service.test.ts backend/domain/budget-income.test.ts backend/domain/account-consistency.test.ts",
    "db:generate": "drizzle-kit generate --config backend/db/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config backend/db/drizzle.config.ts",
    "db:generate:d1": "drizzle-kit generate --config backend/db/drizzle.sqlite.config.ts",
    "db:migrate:d1:local": "wrangler d1 migrations apply luna --local",
    "db:migrate:d1:remote": "wrangler d1 migrations apply luna --remote",
    "db:seed": "npm run db:migrate && node scripts/seed-demo-user.mjs",
    "preview": "npm run build && vite preview --host 0.0.0.0",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv worker-configuration.d.ts"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.4",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "motion": "^13.0.0",
    "next": "^16.3.0",
    "nodemailer": "^9.0.4",
    "otpauth": "^9.5.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "rxdb": "^17.4.0",
    "rxjs": "^7.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "react-server-dom-webpack": "^19.2.6",
    "shadcn": "^4.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vinext": "^0.0.50",
    "vite": "^8.0.13",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  },
  "type": "module"
}
